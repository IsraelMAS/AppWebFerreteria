@model Dominio.Entidades.Marca

@{
ViewBag.Title = "Nueva Marca";
}

<div class="d-flex justify-content-center">
<div class="card shadow-lg p-4" style="width:80%; max-width:850px; border-radius:20px;">

    <h2 class="text-center text-primary mb-4">

        Nueva Marca

    </h2>

    <hr />

    @using (Html.BeginForm())
    {
        <div class="mb-3">

            <label class="form-label fw-bold">

                Nombre de la Marca

            </label>

            @Html.TextBoxFor(
                x => x.NombreMarca,
                new
                {
                    @class = "form-control"
                })

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">

                Descripción

            </label>

            @Html.TextAreaFor(
                x => x.Descripcion,
                new
                {
                    @class = "form-control",
                    rows = 3
                })

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">

                Estado

            </label>

            @Html.DropDownListFor(
                x => x.Estado,
                new List<SelectListItem>
                {
                    new SelectListItem
                    {
                        Text = "Activo",
                        Value = "true"
                    },

                    new SelectListItem
                    {
                        Text = "Inactivo",
                        Value = "false"
                    }
                },
                "-- Seleccione Estado --",
                new
                {
                    @class = "form-control"
                })

        </div>

        <div class="text-center mt-4">

            <button type="submit"
                    class="btn btn-success">

                Guardar

            </button>

            @Html.Raw(" ")

            @Html.ActionLink(
                "Volver",
                "Marcas",
                null,
                new
                {
                    @class = "btn btn-secondary"
                })

        </div>
    }

</div>
